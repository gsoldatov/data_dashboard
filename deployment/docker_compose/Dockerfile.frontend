# Stage 1: build frontend
FROM node:24.10.0 AS builder

WORKDIR /app

# Layer 1: package metadata (cacheable unless package.json/lock changes)
COPY package.json package-lock.json ./
RUN npm ci

# Layer 2: source + config (VITE_BACKEND_URL baked at build time from config.env)
COPY . .
RUN npm run build-vite-dotenv-file && npm run build

# Stage 2: serve via nginx
FROM nginx:1.28-alpine AS runtime

COPY --from=builder /app/dashboard_frontend/dist /usr/share/nginx/html
COPY deployment/docker_compose/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
