# Stage 1: build dependencies
FROM python:3.13.7-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /uvx /bin/

WORKDIR /app

# Layer 1: workspace metadata (cacheable unless pyproject.toml or lock changes)
COPY pyproject.toml uv.lock ./
COPY dashboard_backend/pyproject.toml dashboard_backend/
COPY data_loading/pyproject.toml data_loading/
COPY python_common/pyproject.toml python_common/

RUN uv sync --package data-dashboard --package dashboard_backend --package python_common --no-dev --frozen

# Layer 2: source code
COPY dashboard_backend/ dashboard_backend/
COPY python_common/ python_common/

# Layer 3: runtime config
COPY config.env ./

RUN uv cache clean

# Stage 2: runtime
FROM python:3.13.7-slim AS runtime

COPY --from=builder /app /app

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"

CMD uvicorn dashboard_backend.src.main:app --host 0.0.0.0 --port $BACKEND_PORT
