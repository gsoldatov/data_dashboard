# Common project settings
export ASSETS_DIRECTORY="assets"    # directory for asserts created and used by the project

# Data loading settings
export DATA_LOADING_LOG_MODE="stderr"       # "stderr" or "file"

# Prefect settings
export PREFECT_PROFILE="data_loading_dev"   # a separate profile with custom settings for the current configuration
export PREFECT_SERVER_API_HOST="0.0.0.0"  # Prefect server host & port
export PREFECT_SERVER_API_PORT="14001"
export PREFECT_API_URL="http://127.0.0.1:14001/api"     # Prefect URL for clients (must match server host & port
                                                        # (if client accesses it locally, then 0.0.0.0 must be replaced with 127.0.0.1))

# Dashboard backend settings
export BACKEND_HOST="0.0.0.0"
export BACKEND_PORT="14002"     # should match VITE_BACKEND_URL
export BACKEND_DEFAULT_USER_NAME="admin"
export BACKEND_DEFAULT_USER_PASSWORD="admin"
export BACKEND_SESSION_TTL_SECONDS="604800"         # 7 days
export BACKEND_EXPIRED_SESSIONS_CLEANUP_INTERVAL="3600"   # seconds; how often expired sessions are cleaned up
export BACKEND_CORS_ORIGINS="http://localhost:5173, http://127.0.0.1:5173" # comma-separated list of allowed origins

# Frontend settings (prefix with VITE_ to expose to client code.
# These are extracted into dashboard_frontend/.env by `npm run build-vite-dotenv-file`.)
export VITE_BACKEND_URL="http://localhost:14002"    # should match BACKEND_PORT
