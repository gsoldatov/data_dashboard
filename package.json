{
  "name": "data-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build-vite-dotenv-file": "grep '^export VITE_' config.env | sed 's/^export //' | tr -d '\"' > dashboard_frontend/.env",
    "predev": "npm run build-vite-dotenv-file",
    "prebuild": "npm run build-vite-dotenv-file",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@reduxjs/toolkit": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.6",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vitest-fetch-mock": "^0.4.5"
  }
}
